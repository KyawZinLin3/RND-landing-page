{
  "kind": "collectionType",
  "collectionName": "vacancies",
  "info": {
    "singularName": "vacancy",
    "pluralName": "vacancies",
    "displayName": "Vacancy"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "unique": true
    },
    "location": {
      "type": "string",
      "required": true
    },
    "department": {
      "type": "string"
    },
    "employmentType": {
      "type": "enumeration",
      "enum": ["full-time", "part-time", "contract", "internship"],
      "default": "full-time",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "description": {
      "type": "blocks"
    },
    "requirements": {
      "type": "blocks"
    },
    "applyUrl": {
      "type": "string"
    },
    "closingDate": {
      "type": "date"
    },
    "landingPage": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::landing-page.landing-page",
      "required": true,
      "inversedBy": "vacancies"
    }
  }
}
