{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } },
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "pluginOptions": { "i18n": { "localized": true } },
      "required": true,
      "unique": true
    },
    "contentType": {
      "type": "enumeration",
      "enum": ["news", "post"],
      "pluginOptions": { "i18n": { "localized": false } },
      "default": "post",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "content": {
      "type": "blocks",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "coverImage": {
      "type": "media",
      "pluginOptions": { "i18n": { "localized": true } },
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "authorName": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "seoTitle": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "seoDescription": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "landingPage": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::landing-page.landing-page",
      "pluginOptions": { "i18n": { "localized": false } },
      "required": true,
      "inversedBy": "articles"
    }
  }
}
